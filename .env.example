# Optional keyless local mode (requires Ollama and a downloaded local model):
# SENTINEL_AI_PROVIDER=ollama
# SENTINEL_OLLAMA_MODEL=qwen3:8b
# SENTINEL_OLLAMA_CONTEXT=16384
# OPENAI_TIMEOUT_SECONDS=300
# SENTINEL_AGENT_CHAR_BUDGET=20000
# Keep the OpenRouter settings below for cloud mode.
# Copy this file to backend/.env and fill in your key.
# Works with an OpenAI key or an OpenRouter key (starts with sk-or-). OpenRouter is detected automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
SENTINEL_MAX_UPLOAD_MB=25
SENTINEL_MAX_FILES=20
SENTINEL_AGENT_CHAR_BUDGET=60000
